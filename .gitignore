# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Vercel
.vercel

# Cloudflare Wrangler (로컬 빌드 캐시)
.wrangler/

# Logs
*.log
npm-debug.log*

# Dependency directories
node_modules/
.venv/

# Backup originals (deleted)
assets/images/originals/

# Build scripts (대부분 미배포). 단 i18n 산출물/소스는 배포물(/dobuddy/files/)이라 추적.
scripts/*
!scripts/fill_i18n.py
!scripts/i18n_base/
!scripts/i18n_base/*
!scripts/i18n_out/
!scripts/i18n_out/*

# 편집기 롤백 백업(라이브 원본 스냅샷) — 추적 불필요
editor/*.bak

# Env
.env
.env.local
.env.*.local

# SFTP/expect scripts (비밀번호 평문 포함 — 절대 커밋 금지)
*.exp
